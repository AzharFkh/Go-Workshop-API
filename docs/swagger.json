            "type": "object",
            "required": [
                "amount",
                "part_name"
            ],
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "part_name": {
                    "type": "string"
                }
            }
        },
        "dto.DataServiceResponse": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "part_name": {
                    "type": "string"
                },
                "vehicle_id": {
                    "type": "integer"
                }
            }
        },
        "dto.UserLogin": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "dto.UserRegister": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "dto.VehicleRegister": {
            "type": "object",
            "required": [
                "plate_num",
                "range",
                "vehicle_type"
            ],
            "properties": {
                "plate_num": {
                    "type": "string"
                },
                "range": {
                    "type": "integer"
                },
                "vehicle_type": {
                    "type": "string"
                }
            }
        },
        "dto.VehicleResponse": {
            "type": "object",
            "required": [
                "plate_num",
                "range",
                "user_id",
                "vehicle_type"
            ],
            "properties": {
                "plate_num": {
                    "type": "string"
                },
                "range": {
                    "type": "integer"
                },
                "user_id": {
                    "type": "integer"
                },
                "vehicle_id": {
                    "type": "integer"
                },
                "vehicle_type": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}